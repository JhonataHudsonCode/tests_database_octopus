# =========================
# PostgreSQL principal
# =========================
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=qa_db
PG_USER=qa_user
PG_PASSWORD=qa_password
PG_CONNECT_TIMEOUT=5

# Tabela que será localizada via pg_catalog.pg_tables.
PG_TARGET_SCHEMA=pg_catalog
PG_TARGET_TABLE=pg_type

# =========================
# OpenSearch
# =========================
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# PostgreSQL Cognito (necessário para testes integrados por cliente)
# COGNITO_PG_HOST=localhost
# COGNITO_PG_PORT=5432
# COGNITO_PG_DATABASE=cognito
# COGNITO_PG_USER=postgres
# COGNITO_PG_PASSWORD=senha
# COGNITO_PG_CONNECT_TIMEOUT=5
# COGNITO_PG_TARGET_SCHEMA=public
# COGNITO_PG_TARGET_TABLE=clients

# OpenSearch principal dos clientes, por exemplo o host que começa com "new-".
# NEW_OPENSEARCH_HOST=new.opensearch.exemplo.com
# NEW_OPENSEARCH_PORT=443
# NEW_OPENSEARCH_USER=usuario
# NEW_OPENSEARCH_PASSWORD=senha
# NEW_OPENSEARCH_USE_SSL=true
# NEW_OPENSEARCH_VERIFY_CERTS=true

# OpenSearch Dashboards (opcional; necessário apenas para os testes de dashboards)
# OPENSEARCH_DASHBOARDS_HOST=localhost
# OPENSEARCH_DASHBOARDS_PORT=5601
# OPENSEARCH_DASHBOARDS_USER=admin
# OPENSEARCH_DASHBOARDS_PASSWORD=admin
# OPENSEARCH_DASHBOARDS_USE_SSL=false
# OPENSEARCH_DASHBOARDS_VERIFY_CERTS=false
# OPENSEARCH_DASHBOARDS_PATH_PREFIX=
# OPENSEARCH_DASHBOARDS_REQUEST_TIMEOUT=10
